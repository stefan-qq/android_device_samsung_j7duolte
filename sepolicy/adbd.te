# Native Android 7.1 adbd remains UID 0 in u:r:adbd:s0.
# Avoid the --root_seclabel transition to su and grant the actual runtime
# domain the FunctionFS and ffs.ready property operations it needs.
allow adbd functionfs:filesystem getattr;
allow adbd functionfs:dir r_dir_perms;
allow adbd functionfs:file rw_file_perms;
set_prop(adbd, ffs_prop)

# The forced-FunctionFS selector is published as j720f.usb.transport and is
# labelled twrp_prop by property_contexts. Android property reads are MAC-
# checked, so adbd must be able to read that property before its one-shot USB
# decision. Without this, property_get() returns the empty default and adbd
# silently falls back to TCP port 5555.
get_prop(adbd, twrp_prop)

# Direct-trace files use the dedicated j720f_adbd_trace_file type declared in
# j720f_trace.te. Do not grant adbd generic write access to every tmpfs file.

# /sbin/sh is rootfs-labelled in recovery. The pinned Android 7.1 adbd now
# switches only its forked shell child to u:r:shell:s0 before exec, matching the
# recovery-specific handoff used by newer AOSP adbd. Keep the parent daemon in
# u:r:adbd:s0 so the proven FunctionFS transport and sync service are unchanged.
allow adbd self:process setcurrent;
domain_trans(adbd, rootfs, shell)
allow adbd shell:process dyntransition;
# Keep the inherited recovery LD_LIBRARY_PATH visible to bionic after the
# adbd -> shell SELinux handoff. Without noatsecure, the linker treats the
# subprocess as AT_SECURE and ignores /sbin, so even the present libc.so is
# reported as not found. This matches AOSP recovery adbd policy.
allow adbd shell:process noatsecure;

# After the explicit setcon(), the child is already in u:r:shell:s0 when it
# execs /sbin/sh -> /sbin/busybox. Android 7.1 shell policy can read rootfs
# directories but lacks the recovery-only rootfs execute permission added by
# newer AOSP. Grant only read/execute on rootfs-labelled files.
allow shell rootfs:file rx_file_perms;

# The shell child inherits the adbd-created transport/socket FDs across setcon.
allow shell adbd:fd use;
allow shell adbd:unix_stream_socket { read write ioctl getattr };
