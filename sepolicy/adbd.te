# Native Android 7.1 adbd remains UID 0 in u:r:adbd:s0 for the proven
# FunctionFS/USB transport. Only the forked command child changes domain.
#
# Hardware proved two independent facts on SM-J720F/CUL1:
#   1. Samsung rewrites root ADB exec credentials to AID_SHELL unless the
#      recovery-only kernel credential instruction at +0x154d18 is neutralized.
#   2. With real UID/GID 0 preserved, u:r:adbd:s0 still cannot perform normal
#      recovery operations (readdir /, create /tmp files, klogctl, push/pull),
#      while the native TWRP u:r:recovery:s0 domain can.
#
# Therefore keep the parent USB daemon in u:r:adbd:s0 and dynamically move only
# its already-forked command child into u:r:recovery:s0 before /sbin/sh exec.
# Global SELinux remains Enforcing; adbd/init stay enforcing while this donor
# policy intentionally keeps the recovery domain permissive.
allow adbd functionfs:filesystem getattr;
allow adbd functionfs:dir r_dir_perms;
allow adbd functionfs:file rw_file_perms;
set_prop(adbd, ffs_prop)

# The forced-FunctionFS selector is published as j720f.usb.transport and is
# labelled twrp_prop by property_contexts. Android property reads are MAC-
# checked, so adbd must read it before its one-shot USB decision.
get_prop(adbd, twrp_prop)

# /sbin lives on rootfs. Keep the already-proven adbd read/execute access for
# diagnostics and the command-child handoff. Actual shell execution occurs only
# after the child is in u:r:recovery:s0.
allow adbd rootfs:file rx_file_perms;

# Child-only recovery-domain handoff. setcurrent + dyntransition are required by
# selinux_android_setcon() in the forked shell-service child. The recovery child
# must retain access to the stdio/error descriptors created by adbd.
allow adbd self:process setcurrent;
allow adbd recovery:process dyntransition;

# PTY shells and isolated adb-sync helpers use the preferred exec transition.
# The pending exec context is set only on the service thread that will fork;
# the long-lived USB daemon itself remains u:r:adbd:s0.
allow adbd self:process setexec;
allow adbd recovery:process { transition siginh rlimitinh };
dontaudit adbd recovery:process noatsecure;
allow recovery rootfs:file entrypoint;

# PTY slave descriptors are opened while the child is still in adbd and remain
# generic devpts objects across the exec transition. Recovery must be allowed to
# use that inherited terminal after /sbin/sh enters u:r:recovery:s0.
allow recovery devpts:chr_file { open getattr read write ioctl };

# Complete the cross-domain parent/child lifecycle. waitpid() is SELinux-
# checked as SIGCHLD from the recovery child back to its adbd parent, while
# adbd sends SIGHUP when the host-side shell disconnects.
allow recovery adbd:process sigchld;
allow adbd recovery:process signal;
allow recovery adbd:fd use;
allow recovery adbd:unix_stream_socket { read write ioctl getattr };
