# The Samsung stock kernel forces SELinux enforcing. Keep recovery functional
# with explicit policy rather than permissive-domain declarations.

# TWRP must manage a freshly formatted /data and its emulated-storage tree.
# The builder removes the donor AOSP recovery-only neverallow and exempts
# recovery from the system_data_file write assertion before policy compile.
allow recovery system_data_file:dir create_dir_perms;
allow recovery system_data_file:file create_file_perms;
allow recovery media_rw_data_file:dir create_dir_perms;
allow recovery media_rw_data_file:file create_file_perms;

# Proven working removable-storage path.
allow recovery vfat:dir create_dir_perms;
allow recovery vfat:file create_file_perms;

# TWRP partition hotplug/uevent handling.
allow recovery self:netlink_kobject_uevent_socket create_socket_perms;

# TWRP runtime FIFOs and its embedded terminal PTY.
allow recovery tmpfs:fifo_file create_file_perms;
create_pty(recovery)
allow recovery devpts:dir r_dir_perms;
allow recovery ptmx_device:chr_file rw_file_perms;

# TWRP and diagnostics properties. sys.usb.config is system_radio_prop and
# sys.usb.ffs.ready is ffs_prop in the Android 7.1 policy generation.
set_prop(recovery, twrp_prop)
set_prop(recovery, system_radio_prop)
set_prop(recovery, ffs_prop)

# Read-only runtime inspection of the USB state. Init owns gadget creation.
allow recovery configfs:filesystem getattr;
allow recovery configfs:dir r_dir_perms;
allow recovery configfs:file r_file_perms;
allow recovery configfs:lnk_file r_file_perms;
allow recovery functionfs:filesystem getattr;
allow recovery functionfs:dir r_dir_perms;
allow recovery functionfs:file rw_file_perms;
allow recovery sysfs:dir r_dir_perms;
allow recovery sysfs:file r_file_perms;
allow recovery sysfs_usb:dir r_dir_perms;
allow recovery sysfs_usb:file r_file_perms;

# Kernel-backed Samsung MTP gadget (/dev/usb_mtp_gadget).
allow recovery mtp_device:chr_file rw_file_perms;

# Android 7.1 system/sepolicy/domain.te has an unconditional neverallow against
# writing rootfs-labelled files, so no rootfs write workaround belongs here.

# Recovery clock correction. The stock Samsung kernel boots CLOCK_REALTIME from
# rtc0, but this device can retain a stale PMIC RTC for years while recovery is
# still otherwise healthy. TWRP must be able to set CLOCK_REALTIME and, during
# explicit validation, access rtc0 without relaxing the whole recovery domain.
allow recovery self:capability sys_time;
allow recovery rtc_device:chr_file rw_file_perms;
