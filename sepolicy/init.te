# The Samsung stock kernel forces SELinux enforcing even when Android init asks
# for non-enforcing mode. Grant the exact recovery-init operations needed to
# build the ConfigFS gadget and mount FunctionFS instead of relying on
# permissive domains.

# ConfigFS gadget construction under /sys/kernel/config.
allow init configfs:filesystem { getattr mount remount unmount };
allow init configfs:dir create_dir_perms;
allow init configfs:dir mounton;
allow init configfs:file create_file_perms;
allow init configfs:lnk_file create_file_perms;

# Samsung android_usb and DWC3 sysfs controls used by init rc.
allow init sysfs:dir mounton;
allow init sysfs:dir r_dir_perms;
allow init sysfs:file rw_file_perms;
allow init sysfs_usb:dir r_dir_perms;
allow init sysfs_usb:file rw_file_perms;
