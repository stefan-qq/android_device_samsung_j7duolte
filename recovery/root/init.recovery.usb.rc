# SM-J720F recovery USB: one ADB-only FunctionFS gadget on ConfigFS.
# Android 7.1's canonical ConfigFS mountpoint is /config.

on early-init
    write /sys/fs/selinux/enforce 0
    setprop sys.usb.configfs 1
    setprop sys.usb.controller 13600000.dwc3
    setprop sys.usb.ffs.ready 0

service j720f_permissive /sbin/permissive.sh
    class core
    user root
    group root
    disabled
    oneshot
    seclabel u:r:init:s0

on init
    start j720f_permissive

on fs
    # Never let the legacy android_usb gadget own the controller.
    write /sys/class/android_usb/android0/enable 0

    # The Android 7.1 init layout mounts ConfigFS at /config.
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 root root
    mkdir /config/usb_gadget/g1/strings/0x409 0770 root root
    mkdir /config/usb_gadget/g1/configs/b.1 0770 root root
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 root root
    mkdir /config/usb_gadget/g1/functions/ffs.adb 0770 shell shell

    write /config/usb_gadget/g1/idVendor 0x04E8
    write /config/usb_gadget/g1/idProduct 0x6860
    write /config/usb_gadget/g1/bDeviceClass 0
    write /config/usb_gadget/g1/bDeviceSubClass 0
    write /config/usb_gadget/g1/bDeviceProtocol 0
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer SAMSUNG
    write /config/usb_gadget/g1/strings/0x409/product SM-J720F
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration adb
    write /config/usb_gadget/g1/configs/b.1/MaxPower 0x3f

# Force a property edge after the FunctionFS mount from the base init.rc has
# completed. adbd writes its descriptors and sets sys.usb.ffs.ready=1.
on boot
    setprop sys.usb.config none
    setprop sys.usb.config adb

on property:sys.usb.config=none && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC none
    stop adbd
    setprop sys.usb.ffs.ready 0
    setprop sys.usb.state none

on property:sys.usb.config=adb && property:sys.usb.configfs=1
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=adb && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state adb

on property:init.svc.adbd=stopped
    setprop sys.usb.ffs.ready 0
# Offline USB report. Keep this service in the directly imported USB rc; the
# legacy hardware-named recovery rc does not match ro.hardware=exynos7884.
service j720f_usb_report /sbin/sh /sbin/j720f_usb_report.sh
    class default
    user root
    group root shell
    disabled
    oneshot
    seclabel u:r:init:s0

# Generate one report after TWRP starts and copy it to the working microSD.
on property:init.svc.recovery=running
    start j720f_usb_report
