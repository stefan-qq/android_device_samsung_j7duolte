# Preserve the init sequence used by the best source-built recovery.

on early-init
    write /sys/fs/selinux/enforce 0
    setprop sys.usb.configfs 1
    setprop sys.usb.controller 13600000.dwc3
    setprop sys.usb.j720f.configured 0

on init
    start j720f_permissive

service j720f_permissive /sbin/permissive.sh
    class core
    user root
    group root
    disabled
    oneshot
    seclabel u:r:init:s0

# Execute ConfigFS operations in the recovery domain, which is permissive
# during bring-up. Do not create the duplicate adb.0 function used by v18.

service j720f_usb_setup /sbin/j720f_usb.sh setup
    class core
    user root
    group root shell
    disabled
    oneshot
    seclabel u:r:recovery:s0

service j720f_usb_bind /sbin/j720f_usb.sh bind
    class core
    user root
    group root shell
    disabled
    oneshot
    seclabel u:r:recovery:s0

service j720f_usb_disable /sbin/j720f_usb.sh disable
    class core
    user root
    group root shell
    disabled
    oneshot
    seclabel u:r:recovery:s0

# The base recovery init mounts /dev/usb-ffs/adb during the fs trigger.
# Configure the gadget afterward, then start adbd.

on boot
    start j720f_usb_setup

on property:sys.usb.j720f.configured=1
    setprop sys.usb.config adb
    start adbd

# Bind only after adbd has opened the FunctionFS endpoints.
on property:sys.usb.ffs.ready=1
    start j720f_usb_bind

# TWRP requests MTP even though storage is not usable yet.
on property:sys.usb.config=mtp,adb
    setprop sys.usb.config adb

on property:sys.usb.config=none
    stop adbd
    start j720f_usb_disable
    setprop sys.usb.ffs.ready 0
