# SM-J720F recovery USB: native Android 7.1 FunctionFS adbd transport.
#
# Keep the exact stock kernel, DT, ConfigFS gadget shape and Samsung VID/PID,
# but use the adbd built with the same donor-era init, bionic and property
# protocol as TWRP. The Android 10 adbd bundle reached ep0 but never published
# sys.usb.ffs.ready in this mixed Android 7.1 recovery environment.

on early-init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller 13600000.dwc3
    setprop sys.usb.ffs.ready 0
    setprop j720f.usb.transport native-android71-ffs
    setprop j720f.usb.early_init_action 1

on fs
    mount configfs none /sys/kernel/config
    mkdir /sys/kernel/config/usb_gadget/g1 0770 root root
    mkdir /sys/kernel/config/usb_gadget/g1/strings/0x409 0770 root root
    mkdir /sys/kernel/config/usb_gadget/g1/configs/c.1 0770 root root
    mkdir /sys/kernel/config/usb_gadget/g1/configs/c.1/strings/0x409 0770 root root

    write /sys/kernel/config/usb_gadget/g1/idVendor 0x04E8
    write /sys/kernel/config/usb_gadget/g1/idProduct 0x6860
    write /sys/kernel/config/usb_gadget/g1/bDeviceClass 0
    write /sys/kernel/config/usb_gadget/g1/bDeviceSubClass 0
    write /sys/kernel/config/usb_gadget/g1/bDeviceProtocol 0
    write /sys/kernel/config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /sys/kernel/config/usb_gadget/g1/strings/0x409/manufacturer SAMSUNG
    write /sys/kernel/config/usb_gadget/g1/strings/0x409/product SAMSUNG_Android
    write /sys/kernel/config/usb_gadget/g1/configs/c.1/strings/0x409/configuration adb
    write /sys/kernel/config/usb_gadget/g1/configs/c.1/MaxPower 0x3f

    mkdir /sys/kernel/config/usb_gadget/g1/functions/ffs.adb 0770 shell shell
    symlink /sys/kernel/config/usb_gadget/g1/functions/ffs.adb /sys/kernel/config/usb_gadget/g1/configs/c.1/ffs.adb

    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    setprop j720f.usb.ffs_mount_action 1
    setprop j720f.usb.configfs_action 1

on boot
    setprop j720f.usb.boot_action 1
    setprop sys.usb.config none
    setprop sys.usb.config adb

on property:sys.usb.config=none && property:sys.usb.configfs=1
    write /sys/kernel/config/usb_gadget/g1/UDC none
    stop adbd
    setprop sys.usb.ffs.ready 0
    setprop sys.usb.state none

# Start the native donor-era recovery adbd after FunctionFS is mounted.
on property:sys.usb.config=adb && property:sys.usb.configfs=1
    start adbd
    setprop j720f.usb.adbd_start_action 1

# adbd publishes ffs.ready only after it opens ep0 and writes descriptors.
on property:sys.usb.config=adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /sys/class/android_usb/android0/enable 0
    write /sys/kernel/config/usb_gadget/g1/idVendor 0x04E8
    write /sys/kernel/config/usb_gadget/g1/idProduct 0x6860
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    write /sys/class/android_usb/android0/functions adb
    write /sys/kernel/config/usb_gadget/g1/UDC ${sys.usb.controller}
    write /sys/class/android_usb/android0/enable 1
    setprop j720f.usb.udc_bind_action 1
    setprop sys.usb.state adb

on property:init.svc.adbd=stopped
    setprop sys.usb.ffs.ready 0

# Safe asynchronous runtime report.
service j7diag /sbin/sh /sbin/j720f_runtime_diag.sh
    class default
    user root
    group root shell
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:init.svc.recovery=running
    setprop j720f.diag.triggered 1
    start j7diag
