# SM-J720F recovery USB: native Android 7.1 FunctionFS direct-trace transport.
#
# Keep the exact stock kernel, DT, ConfigFS gadget shape and Samsung VID/PID,
# but use the adbd built with the same donor-era init, bionic and property
# protocol as TWRP. The Android 10 adbd bundle reached ep0 but never published
# sys.usb.ffs.ready in this mixed Android 7.1 recovery environment.

on early-init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller 13600000.dwc3
    setprop sys.usb.ffs.ready 0
    setprop j720f.usb.transport native-android71-ffs
    setprop j720f.usb.adbd_domain_only 1
    setprop j720f.usb.direct_trace 1
    setprop j720f.usb.force_ffs_entry 1
    setprop j720f.usb.pure_configfs 0
    setprop j720f.usb.stock_android_usb_gate 1
    setprop j720f.usb.stock_link_order 1
    setprop persist.adb.trace_mask all
    setprop j720f.usb.early_init_action 1

on fs
    # Pre-create fixed tmpfs trace targets before adbd starts. The source-built
    # daemon appends direct syscall results to the first file and redirects its
    # native ADB trace stream to the second. Neither path depends on /data.
    write /tmp/J720F_ADBD_USB_TRACE.txt J720F_USB_DIAG_INIT_PRECREATED
    restorecon /tmp/J720F_ADBD_USB_TRACE.txt
    chown root shell /tmp/J720F_ADBD_USB_TRACE.txt
    chmod 0664 /tmp/J720F_ADBD_USB_TRACE.txt
    write /tmp/J720F_ADBD_TRACE.txt J720F_ADBD_TRACE_INIT_PRECREATED
    restorecon /tmp/J720F_ADBD_TRACE.txt
    chown root shell /tmp/J720F_ADBD_TRACE.txt
    chmod 0664 /tmp/J720F_ADBD_TRACE.txt
    setprop j720f.usb.trace_precreated 1

    mount configfs none /sys/kernel/config
    mkdir /sys/kernel/config/usb_gadget/g1 0770 root root
    mkdir /sys/kernel/config/usb_gadget/g1/strings/0x409 0770 root root
    mkdir /sys/kernel/config/usb_gadget/g1/configs/c.1 0770 root root
    mkdir /sys/kernel/config/usb_gadget/g1/configs/c.1/strings/0x409 0770 root root

    write /sys/kernel/config/usb_gadget/g1/idVendor 0x04E8
    write /sys/kernel/config/usb_gadget/g1/idProduct 0x6860
    write /sys/kernel/config/usb_gadget/g1/bDeviceClass 0
    write /sys/kernel/config/usb_gadget/g1/bDeviceSubClass 0
    write /sys/kernel/config/usb_gadget/g1/bDeviceProtocol 0
    write /sys/kernel/config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /sys/kernel/config/usb_gadget/g1/strings/0x409/manufacturer SAMSUNG
    write /sys/kernel/config/usb_gadget/g1/strings/0x409/product SAMSUNG_Android
    # Keep the exact CUL1 configuration string. Samsung CONFIG_USB_CONFIGFS_UEVENT
    # treats other strings (notably "adb") as a GSI path during the config symlink.
    write /sys/kernel/config/usb_gadget/g1/configs/c.1/strings/0x409/configuration "Conf 1"
    write /sys/kernel/config/usb_gadget/g1/configs/c.1/MaxPower 0x3f

    mkdir /sys/kernel/config/usb_gadget/g1/functions/ffs.adb 0770 shell shell
    # Match the exact Samsung stock-recovery topology: register the ffs.adb
    # function with c.1 before FunctionFS is mounted and before adbd opens ep0.
    # The stock kernel rejected a link created only after ffs.ready with
    # "Config c/1 of g1 needs at least one function" even though the late
    # symlink remained visible in ConfigFS. Keep this link for the whole boot.
    symlink /sys/kernel/config/usb_gadget/g1/functions/ffs.adb /sys/kernel/config/usb_gadget/g1/configs/c.1/ffs.adb

    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    # This recovery deliberately keeps adbd as UID/GID 0. FunctionFS applies
    # its mount uid/gid to ep0 and the later bulk endpoints, so make root the
    # endpoint owner instead of the stock shell owner. The previous shell-owned
    # ep0 was mode 0600 and every adbd O_RDWR open failed with EACCES.
    mount functionfs adb /dev/usb-ffs/adb uid=0,gid=0
    setprop j720f.usb.ffs_mounted 1
    setprop j720f.usb.ffs_mount_action 1
    setprop j720f.usb.configfs_action 1

on boot
    setprop j720f.usb.boot_action 1
    setprop sys.usb.config none
    setprop sys.usb.config adb

on property:sys.usb.config=none && property:sys.usb.configfs=1
    write /sys/kernel/config/usb_gadget/g1/UDC none
    # Do not unlink ffs.adb here. Samsung stock recovery creates the link
    # before mounting FunctionFS and preserves it across USB state changes.
    stop adbd
    setprop sys.usb.ffs.ready 0
    setprop sys.usb.state none

# Start the native donor-era recovery adbd after FunctionFS is mounted.
# It remains UID 0 in u:r:adbd:s0; there is no adbd -> su dyntransition.
on property:sys.usb.config=adb && property:sys.usb.configfs=1 && property:j720f.usb.ffs_mounted=1
    # Reassert immediately before process creation so adbd observes tracing even
    # if a later property-load action replaced the early-init value.
    setprop persist.adb.trace_mask all
    start adbd
    setprop j720f.usb.adbd_start_action 1

# adbd publishes ffs.ready only after it opens ep0 and writes descriptors.
# The ffs.adb function was already linked into c.1 during the fs action, in
# the same order used by the exact Samsung Android 10 stock recovery. Bind the
# already-complete ConfigFS gadget only after FunctionFS is ready.
on property:sys.usb.config=adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    # The CUL1 Samsung 4.4 kernel uses the legacy android_usb sysfs gate around
    # its ConfigFS UDC attach. PID 1 reaches g1/UDC successfully without this
    # sequence, but the ConfigFS UDC attach returns -EINVAL. Reproduce only the
    # four stock-recovery gate writes while keeping our proven ConfigFS/FFS
    # topology and native recovery adbd unchanged.
    write /sys/class/android_usb/android0/enable 0
    write /sys/kernel/config/usb_gadget/g1/idVendor 0x04E8
    write /sys/kernel/config/usb_gadget/g1/idProduct 0x6860
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    write /sys/class/android_usb/android0/functions adb
    write /sys/kernel/config/usb_gadget/g1/UDC ${sys.usb.controller}
    write /sys/class/android_usb/android0/enable 1
    setprop j720f.usb.configfs_bind 1
    setprop j720f.usb.udc_bind_action 1
    setprop sys.usb.state adb

on property:init.svc.adbd=stopped
    setprop sys.usb.ffs.ready 0

# Safe asynchronous runtime report.
service j7diag /sbin/sh /sbin/j720f_runtime_diag.sh
    class default
    user root
    group root shell readproc
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:init.svc.recovery=running
    setprop j720f.diag.triggered 1
    start j7diag
