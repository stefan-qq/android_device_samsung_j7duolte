# Force permissive mode directly from init before recovery starts.
# The service-based setenforce attempts are packaged but have no runtime effect.

on early-init
    write /sys/fs/selinux/enforce 0

# Run the permissive helper in init's SELinux domain.
# The donor service runs as recovery and cannot change enforcement.

on init
    start j720f_permissive

service j720f_permissive /sbin/permissive.sh
    class core
    user root
    group root
    disabled
    oneshot
    seclabel u:r:init:s0

# Samsung legacy android_usb gadget flow used by the exact donor generation.
# This intentionally avoids ConfigFS and creates only one ADB interface.

on fs
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 04E8
    write /sys/class/android_usb/android0/idProduct 6860
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/iManufacturer SAMSUNG
    write /sys/class/android_usb/android0/iProduct SM-J720F
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}

on property:sys.usb.config=none
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/bDeviceClass 0
    setprop sys.usb.state none

on property:sys.usb.config=adb
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/functions adb
    start adbd
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state adb

on property:sys.usb.config=mtp,adb
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/functions mtp,adb
    start adbd
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state mtp,adb

on property:sys.usb.config=mass_storage,adb
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/functions mass_storage,adb
    start adbd
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state mass_storage,adb
