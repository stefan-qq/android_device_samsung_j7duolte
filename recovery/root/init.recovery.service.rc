# Do not start TWRP until ueventd has completed the initial coldboot scan.
# Small init changes previously changed whether TWRP could create its runtime
# fstab and open the kernel uevent socket.

on boot
    wait /dev/.coldboot_done
    start recovery
    setprop sys.j720f.recovery.started 1

service recovery /sbin/recovery
    disabled
    seclabel u:r:recovery:s0
